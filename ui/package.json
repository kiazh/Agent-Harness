{
  "name": "agent-harness-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHarness terminal UI (TypeScript, built on @earendil-works/pi-tui). Talks to the Python gateway over JSON-RPC on stdio.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "~5.6.0"
  }
}
