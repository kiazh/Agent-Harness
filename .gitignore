# Host-side operator scripts (see scripts/README.md); keep the directory
# itself present for the compose bind mount, ignore its contents.
scripts/*
!scripts/README.md
agents/
skills/telemetry.json
skills/telemetry.json.lock
.skill-hub/
.hypothesis/
.pytest_cache/
.ruff_cache/
__pycache__/
*.egg-info/

# Keep the public wire contract; other communications remain internal.
!communications/
communications/*
!communications/ui-gateway-protocol.md

# Pinned ECC distribution includes directories otherwise ignored above.
!skills/ecc/**
# Generated caches are not part of the pinned distribution.
skills/ecc/**/__pycache__/
skills/ecc/**/*.py[cod]
# ECC upstream test suites are never tracked here; the installed
# ecc-universal distribution and any future vendor copy ship without them.
skills/ecc/**/tests/
skills/ecc/**/test/
skills/ecc/**/*_test.py
skills/ecc/**/*.test.ts
skills/ecc/**/*.test.js
vendor/ecc/**/tests/
vendor/ecc/**/test/

# Archived virtual environments and generated coverage
.venv.*/
coverage.xml

# Installed Node dependencies are restored from the lockfile
node_modules/

# Proof artifacts: evidence logs under docs/verification/proofs/ are tracked
!docs/verification/proofs/**/*.log

# Machine-specific MCP registration (create via: opencode mcp add machina -- <python> -m machina.mcp_server)
opencode.json
