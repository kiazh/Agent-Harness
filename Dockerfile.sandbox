FROM python:3.11-slim

WORKDIR /build
COPY pyproject.toml README.md ./
COPY ah ./ah

RUN apt-get update && apt-get install -y --no-install-recommends \
    git findutils grep coreutils diffutils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir '.[dev]'

USER 65534:65534
WORKDIR /workspace
