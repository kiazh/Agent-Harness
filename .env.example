# AgentHarness environment variables
# Copy to .env (git-ignored) and fill in your values. Secrets belong here,
# never in ~/.agent-harness/config.yaml.

# Database (PostgreSQL with the pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentharness

# Separate database used by the test suite (tests never touch DATABASE_URL)
AGENT_HARNESS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentharness_test

# LLM providers (one entry per model family you use — see /keys menu, ah setup)
OPENROUTER_API_KEY=sk-or-...
AGENT_HARNESS_MODEL=openrouter/free
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=xai-...
# COHERE_API_KEY=...

# Optional lifetime budgets per session and agent (0 = unlimited).
# AGENT_HARNESS_USAGE_SESSION_TOKEN_LIMIT=50000
# AGENT_HARNESS_USAGE_SESSION_REQUEST_LIMIT=100
# AGENT_HARNESS_USAGE_AGENT_TOKEN_LIMIT=500000
# AGENT_HARNESS_USAGE_AGENT_REQUEST_LIMIT=1000

# Required when starting the Docker Compose HTTP API
AGENT_HARNESS_API_KEY=replace-with-a-long-random-key

# Optional key for authenticated memory provenance and cross-agent sharing.
AGENT_HARNESS_PROVENANCE_KEY=replace-with-a-separate-long-random-key

# Persona-conditioned memory retrieval (default-on).
# AGENT_HARNESS_PERSONA_MEMORY_ENABLED=true
# AGENT_HARNESS_PERSONA_DEFAULT_EMOTION=trust

# Web search (optional — self-hosted SearXNG)
SEARXNG_URL=http://localhost:8080

# Configuration precedence: session override -> AGENT_HARNESS_<KEY> -> legacy
# environment -> mounted secret file -> secret backend -> non-secret YAML -> default.
# Dotenv only fills absent environment values; never put credentials in YAML.
# Explicit invalid mounted files fail instead of falling back to another value.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# AGENT_HARNESS_WORKSPACE_ROOT=/srv/agent-workspace
# AGENT_HARNESS_SCRIPTS_DIR=/srv/trusted-agent-scripts
# Scripts require administrator-owned .script-policy.json (see SECURITY.md).
# AGENT_HARNESS_TURN_TIMEOUT=300
# AGENT_HARNESS_APPROVAL_TIMEOUT=300
# AGENT_HARNESS_HTTP_RATE_LIMIT=120
# Full deployment, retention, monitoring and backup/restore contract: OPERATIONS.md
