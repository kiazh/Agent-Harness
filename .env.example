# Machina environment variables
# Copy to .env (git-ignored) and fill in your values. Secrets belong here,
# never in ~/.machina/config.yaml.

# Database (PostgreSQL with the pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/machina

# Separate database used by the test suite (tests never touch DATABASE_URL)
MACHINA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/machina_test

# LLM providers (one entry per model family you use — see /keys menu, machina setup)
# F-09: placeholders stay commented so they can never satisfy compose's
# `${MACHINA_API_KEY:?}` guard or shadow a mounted `*_FILE` / Vault secret.
# install.sh fills a missing OPENROUTER_API_KEY interactively (or leaves it
# unset and prints `machina setup` guidance); `machina setup` writes it later.
# OPENROUTER_API_KEY=sk-or-...
MACHINA_MODEL=openrouter/free
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=xai-...
# OpenCode Zen gateway (free + paid models; create a key in the OpenCode
# console). Use with MACHINA_PROVIDER=opencode and MACHINA_MODEL=<model>.
# OPENCODE_API_KEY=...
# Optional Zen base-url override (default https://opencode.ai/inference/v1;
# https://opencode.ai/zen/v1 serves the same catalog).
# OPENCODE_BASE_URL=
# Kimi Code (K3 / K2.x coding models): create a key in the Kimi Code Console
# (<https://www.kimi.com/code/console>); a membership supplies the coding
# quota. Use with MACHINA_PROVIDER=kimi and MACHINA_MODEL=<model id, e.g.
# kimi-for-coding, k3, k3-256k>.
# KIMI_API_KEY=...
# Any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp, Hermes proxy):
# MACHINA_PROVIDER=custom, MACHINA_MODEL=<served model id>; the key is
# optional (keyless local servers are supported).
# CUSTOM_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_API_KEY=...
# COHERE_API_KEY=...

# Dense-retrieval embeddings (optional; default is keyword-only). Enable with
# "onnx" (in-process ONNX; pip install 'Machina[embeddings-onnx]'), "local"
# (static model2vec; pip install 'Machina[embeddings-local]'), "openai", or
# "auto" (explicit endpoint → ONNX → model2vec → OpenAI/OpenRouter keys).
# MACHINA_EMBEDDING_BACKEND=onnx
# MACHINA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MACHINA_EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1

# Cross-encoder reranking (optional; default is passthrough). Enable with
# "local" (in-process ONNX; pip install 'Machina[rerank]'), "cohere", or
# "http" for a llama.cpp /v1/rerank server.
# MACHINA_RERANKER_BACKEND=local
# MACHINA_RERANKER_LOCAL_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
# MACHINA_RERANKER_HTTP_URL=http://127.0.0.1:8080   # llama-server --reranking
# MACHINA_RERANKER_HTTP_MODEL=bge-reranker-v2-m3

# Hybrid-search RRF fusion weights (dense vs keyword; only used when dense is
# enabled). Measured default: 1.0 keyword / 0.25 dense.
# MACHINA_RRF_KEYWORD_WEIGHT=1.0
# MACHINA_RRF_DENSE_WEIGHT=0.25

# Optional lifetime budgets per session and agent (0 = unlimited).
# MACHINA_USAGE_SESSION_TOKEN_LIMIT=50000
# MACHINA_USAGE_SESSION_REQUEST_LIMIT=100
# MACHINA_USAGE_AGENT_TOKEN_LIMIT=500000
# MACHINA_USAGE_AGENT_REQUEST_LIMIT=1000

# Required when starting the Docker Compose HTTP API (or any HTTP deployment).
# Leave unset in this template: compose refuses to start until a real key is
# provided (environment or a secret backend), and install.sh/machina setup
# generates a random one. Generate manually with: openssl rand -hex 32
# MACHINA_API_KEY=replace-with-a-long-random-key

# Optional key for authenticated memory provenance and cross-agent sharing.
# MACHINA_PROVENANCE_KEY=replace-with-a-separate-long-random-key

# MCP OAuth master key: base64 of exactly 32 random bytes. Required on
# headless/Docker hosts without an allowlisted OS keyring (otherwise OAuth
# reports `storage_unavailable`). install.sh generates one when absent.
# Generate manually with:
#   python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# MACHINA_OAUTH_MASTER_KEY=replace-with-a-base64-32-byte-key

# Persona-conditioned memory retrieval (default-on).
# MACHINA_PERSONA_MEMORY_ENABLED=true
# MACHINA_PERSONA_DEFAULT_EMOTION=trust

# Runtime learning (default-on). Post-turn learned skills publish themselves
# within bounded caps (creation-only, versioned, revertible); the daily cap
# counts auto-applied reviews per agent, and 0 falls back to stage-only review.
# MACHINA_LEARNING_REVIEW_AUTO_APPLY=true
# MACHINA_LEARNING_REVIEW_AUTO_APPLY_PER_DAY=5
# Directory for agent-learned skills (runtime data; default ~/.machina/skills).
# MACHINA_LEARNED_SKILLS_DIR=/srv/machina-learned-skills

# Optional search provider; leave empty to use keyless DuckDuckGo search.
# Set this to a public SearXNG endpoint when you run one.
SEARXNG_URL=

# Configuration precedence: session override -> MACHINA_<KEY> -> legacy
# environment -> mounted secret file -> secret backend -> non-secret YAML -> default.
# Dotenv only fills absent environment values; never put credentials in YAML.
# Explicit invalid mounted files fail instead of falling back to another value.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# MACHINA_WORKSPACE_ROOT=/srv/agent-workspace
# MACHINA_SCRIPTS_DIR=/srv/trusted-agent-scripts
# Scripts require administrator-owned .script-policy.json (see SECURITY.md).
# MACHINA_TURN_TIMEOUT=300
# MACHINA_APPROVAL_TIMEOUT=300
# MACHINA_HTTP_RATE_LIMIT=120
# Full deployment, retention, monitoring and backup/restore contract: OPERATIONS.md
